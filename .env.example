# Configuration d'exemple, sans aucun secret.
# Développement local : copier ce fichier en api/.env et adapter si besoin.
# Docker Compose définit lui-même ces variables (voir docker-compose.yml).

# Base de développement, lancée par `docker compose up -d db`
DATABASE_URL=postgresql://portail:portail@localhost:5432/portail

# Port de l'API
PORT=3000

# Secret de signature des sessions : une longue valeur aléatoire, propre à chaque environnement.
# L'API refuse de démarrer sans lui.
SESSION_SECRET=a-remplacer-par-une-longue-valeur-aleatoire

# Attribut Secure du cookie de session : true SEULEMENT derrière HTTPS.
# En HTTP (développement, docker compose sur http://localhost:3000), il doit rester à false :
# avec Secure, express-session n'envoie pas le cookie et la connexion ne fonctionne pas.
COOKIE_SECURE=false

# IA en mode simulé par défaut : aucune clé nécessaire.
# LLM_MODE=connecte utilise l'API Groq (offre gratuite) : l'API refuse de démarrer sans clé.
LLM_MODE=mock
# Clé Groq (console.groq.com), côté serveur seulement : ne jamais la commiter ni la partager.
GROQ_API_KEY=
# Modèle Groq du mode connecté.
GROQ_MODEL=openai/gpt-oss-120b

# Mode de départ de la banque simulée : SUCCES (défaut), ECHEC ou REPONSE_PERDUE.
# Modifiable pendant la démonstration par POST /api/demo/banque/mode (si DEMO_MODE=true).
BANK_MODE=SUCCES

# Dossier des justificatifs (facultatif) : par défaut api/uploads/, hors de Git.
# UPLOADS_DIR=uploads

# Mode démonstration : routes /api/demo/... (mode de la banque simulée), et création des
# comptes de démonstration par `npm run seed`. À false hors démonstration.
DEMO_MODE=true
